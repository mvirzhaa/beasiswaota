[Unit]
Description=Beasiswa OTA - notifikasi laporan penyaluran akhir semester (email + WA)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/beasiswaota/cron.env
ExecStart=/usr/bin/curl -fsS -X POST \
  -H "x-cron-secret: ${CRON_SECRET}" \
  https://beasiswaota.uika-bogor.ac.id/api/cron/laporan-semester
