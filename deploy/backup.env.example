# Salin ke /etc/beasiswaota/backup.env (chmod 600, dimiliki root) —
# JANGAN taruh file terisi ini di repo.

POSTGRES_USER=beasiswaota
POSTGRES_DB=beasiswaota
MINIO_BUCKET=beasiswaota-berkas

# Passphrase GPG untuk enkripsi dump database. Simpan salinannya di
# password manager terpisah — kalau hilang, dump lama tidak bisa dibuka.
BACKUP_GPG_PASSPHRASE=ganti-dengan-passphrase-panjang-dan-acak

# Host tujuan backup, HARUS di luar VPS aplikasi ini. Format: user@host
# SSH key (bukan password) dari root harus sudah bisa login passwordless
# ke host ini (ssh-copy-id).
BACKUP_REMOTE_HOST=backup-user@backup-host.example.com
BACKUP_REMOTE_PATH=/home/backup-user/beasiswaota

# Berapa hari backup staging lokal (bukan remote) disimpan sebelum dihapus.
RETENSI_HARI=14
