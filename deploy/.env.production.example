# Contoh .env PRODUKSI — salin ke /opt/beasiswaota/shared/.env di VPS
# (chmod 600, dimiliki user beasiswaota), lalu symlink ke lokasi yang
# dibaca deploy: root repo (untuk Docker Compose) atau
# /opt/beasiswaota/current/.env (untuk PM2/systemd native).
#
# JANGAN commit file ini setelah diisi nilai sungguhan.

NODE_ENV=production
APP_URL=https://beasiswaota.uika-bogor.ac.id

# db di sini adalah NAMA SERVICE compose (deploy/docker-compose.prod.yml),
# bukan localhost — aplikasi menjangkaunya lewat jaringan internal compose.
# Kalau app dijalankan native (PM2/systemd) sementara db tetap di Docker,
# pakai 127.0.0.1:5433 (port yang di-bind ke loopback di compose).
DATABASE_URL="postgresql://beasiswaota:GANTI_PASSWORD_KUAT@db:5432/beasiswaota?schema=public"
POSTGRES_USER=beasiswaota
POSTGRES_PASSWORD=GANTI_PASSWORD_KUAT
POSTGRES_DB=beasiswaota

AUTH_SECRET=ganti-dengan-hasil-openssl-rand-base64-32-BARU-untuk-produksi

# MINIO_ENDPOINT WAJIB domain publik (subdomain storage), BUKAN
# "minio"/"localhost" — signed URL (buatUrlTerlindungi) dibuat dengan host
# ini dan harus persis sama dengan yang benar-benar diakses browser lewat
# Nginx (deploy/nginx/beasiswaota.conf). Lihat catatan di file nginx itu.
MINIO_ENDPOINT=storage.beasiswaota.uika-bogor.ac.id
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ROOT_USER=beasiswaota
MINIO_ROOT_PASSWORD=GANTI_PASSWORD_KUAT_MINIO
MINIO_BUCKET=beasiswaota-berkas

RESEND_API_KEY=re_isi_kunci_produksi
MAIL_FROM=beasiswaota@uika-bogor.ac.id

CRON_SECRET=ganti-dengan-secret-acak-panjang-BARU-untuk-produksi

MIDTRANS_SERVER_KEY=isi_server_key_produksi
MIDTRANS_CLIENT_KEY=isi_client_key_produksi
MIDTRANS_IS_PRODUCTION=true
