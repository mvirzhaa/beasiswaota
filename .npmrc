# next-auth@5 beta menyatakan peer dependency opsional ke nodemailer versi
# lama (^7 || ^8) untuk provider Email bawaannya yang tidak kita pakai
# (auth pakai Credentials provider sendiri, lihat src/lib/auth.ts).
# Tanpa ini "npm ci" gagal di Docker build karena konflik peer meski
# npm install biasa mengizinkannya.
legacy-peer-deps=true
