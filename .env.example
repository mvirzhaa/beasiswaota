# ============================================================================
# Salin berkas ini menjadi .env dan isi nilai sesungguhnya.
# JANGAN commit .env ke repo.
# ============================================================================

# --- Aplikasi ---
NODE_ENV=development
# Semua URL absolut di kode WAJIB diambil dari env ini, jangan hardcode domain.
APP_URL=http://localhost:3000

# --- Database ---
# Port host sengaja 5433, bukan 5432 default Postgres, supaya tidak bentrok
# dengan instance Postgres lain yang mungkin sudah jalan di mesin developer.
DATABASE_URL="postgresql://beasiswaota:beasiswaota@localhost:5433/beasiswaota?schema=public"
POSTGRES_USER=beasiswaota
POSTGRES_PASSWORD=beasiswaota
POSTGRES_DB=beasiswaota
POSTGRES_PORT=5433

# --- Auth.js ---
AUTH_SECRET=ganti-dengan-hasil-openssl-rand-base64-32

# Path login khusus admin (tidak ditautkan di UI publik manapun, lihat
# src/app/[secretSlug]/page.tsx). Ganti dengan string acak sendiri per
# environment, jangan pakai nilai contoh ini di production.
ADMIN_LOGIN_PATH=portal-kelola-ganti-ini-x7k9

# --- MinIO (storage privat, jangan taruh berkas di public/) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=beasiswaota
MINIO_ROOT_PASSWORD=beasiswaota123
MINIO_BUCKET=beasiswaota-berkas
# Bucket TERPISAH, publik (aset landing page: hero/pilar/pimpinan/logo) —
# beda dari MINIO_BUCKET yang privat untuk berkas pengajuan.
MINIO_BUCKET_PUBLIK=beasiswaota-publik

# --- Email (Resend) ---
RESEND_API_KEY=re_ganti_ini
MAIL_FROM=beasiswaota@uika-bogor.ac.id

# --- WhatsApp (pengingat komitmen berkelanjutan, opsional) ---
# Kosongkan dulu kalau provider WA belum ditentukan — kirimWa() no-op aman.
# Isi sesuai provider yang dipakai (mis. Fonnte/Wablas): URL endpoint kirim
# pesan dan token/API key akun tersebut.
WA_API_URL=
WA_API_TOKEN=

# --- Cron (VPS pakai systemd timer / cron sistem, bukan Vercel Cron) ---
CRON_SECRET=ganti-dengan-secret-acak-panjang

# --- Payment gateway (Midtrans Snap, dipakai mulai Sesi 8) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
